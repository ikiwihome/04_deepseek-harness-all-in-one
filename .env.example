# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取同目录的 .env。

# ── 模型密钥（可选，也可以留空）─────────────────────────────────────────────
# 填了：首启会把它写进凭据文件，之后容器不再保留这个环境变量，因此
#       「设置 → 模型」里可以随时替换它（改这里对已初始化过的部署不再生效）。
# 留空：首启不播种，登录后在「设置 → 模型」里填即可（推荐）。
DEEPSEEK_API_KEY=
#
# 更安全的写法：密钥放文件里，用 *_FILE 指过去（优先于上面的变量）。
# 环境变量会出现在 `docker inspect` 里，文件内容不会。做法：
#   mkdir secrets && 把密钥写进 secrets/deepseek_api_key（Windows 用 icacls 收紧）
#   在 docker-compose.yml 的 volumes 里挂载 ./secrets:/run/secrets:ro
#   然后在这里写：DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
# 同理还有 DSH_ADMIN_PASSWORD_FILE、SETUP_KEY_FILE。
#DEEPSEEK_API_KEY_FILE=

# ── 默认登录账号（这就是“默认密码”的配置点）─────────────────────────────────
# 密码策略：>=12 位，且含大写、小写、数字、符号，<=72 字节。
# 只在首次启动、平台尚未初始化时生效；之后改这里不会重置已有账号。
DSH_ADMIN_USERNAME=admin
DSH_ADMIN_PASSWORD=ChangeMe@2026!

# ── 外观与权限的默认值 ──────────────────────────────────────────────────────
# 主题：默认 DSH 官方默认的浅色主题（可在「设置 → 外观」里改，改后以界面为准）。
# 皮肤：默认不激活（官方原版外观）；whale-fantasy 已预装，在「设置 → 皮肤中心」启用。
# 想开箱就激活某个皮肤，填 id：
#DSH_SKIN_ID=whale-fantasy
# 默认权限：完全权限。DSH 自己的开关（沙箱 danger-full-access + 审批 never）。
#DSH_PERMISSION_MODE=danger-full-access
# dsh-passwords 的「聊天入口 · 显示可拖动的聊天气泡」：默认关闭（0）。
# 只给“还没在界面里设置过”的账号写默认值，你改过之后不会再被覆盖。
#DSH_PASSWORDS_CHAT_BUBBLE=0

# ── 端口：宿主机对外端口（直接暴露，给 nginx 反代用）────────────────────────
DSH_PORT=3088

# ── 数据目录：三个持久化目录都放在它下面 ────────────────────────────────────
#   $DSH_DATA_DIR/dsh-home      → 容器 /data/dsh
#   $DSH_DATA_DIR/dsh-passwords → 容器 /data/dsh-passwords
#   $DSH_DATA_DIR/workspace     → 容器 /workspace
# 默认 /data/deepseek-harness-all-in-one。
# ⚠️ 在 Docker Desktop（Windows）上，绝对路径 /data/... 位于 Docker Desktop 虚拟机内部：
#    资源管理器里看不到，而且 "Reset / Purge data" 会连它一起清掉。想放到 Windows 可见、
#    可备份的位置就改成盘符路径（下面二选一）。
#DSH_DATA_DIR=D:/data/deepseek-harness-all-in-one
#DSH_DATA_DIR=/d/data/deepseek-harness-all-in-one

# ── compose 项目名（固定，别跟随目录名）─────────────────────────────────────
# 改名目录时如果不固定项目名，compose 会当成新项目另起一套容器/卷。
#DSH_PROJECT_NAME=deepseek-harness

# 镜像名与容器名
#DSH_IMAGE=dsh-local:latest
#DSH_CONTAINER_NAME=dsh

# 语言/时区
TZ=Asia/Shanghai
